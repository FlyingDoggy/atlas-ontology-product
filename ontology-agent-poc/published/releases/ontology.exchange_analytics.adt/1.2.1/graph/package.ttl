ex:process.adt_analysis a ex:Process ;
    rdfs:label "Governed ADT Analysis Process"@en,
        "受治理ADT分析流程"@zh ;
    ex:definition "End-to-end process from a user question through policy, semantic binding, deterministic execution, validation and evidence." ;
    ex:governedByDecision ex:decision.calendar_day,
        ex:decision.decomposition,
        ex:decision.eligible_trade ;
    ex:hasStep ex:process.adt_analysis.authorize,
        ex:process.adt_analysis.bind,
        ex:process.adt_analysis.execute,
        ex:process.adt_analysis.verify ;
    ex:id "process.adt_analysis" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:trigger "An approved user submits an ADT fact, comparison, driver or evidence question." ;
    ex:version "1.0.0" .

ex:process.adt_analysis.authorize a ex:ProcessStep ;
    rdfs:label "Check role, requested grain and denied fields" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "PolicyGate" ;
    ex:uses ex:policy.aggregate_market_access .

ex:process.adt_analysis.bind a ex:ProcessStep ;
    rdfs:label "Resolve periods, metrics and registered analysis pattern" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "SemanticBinding" ;
    ex:uses ex:analysis.evidence_audit,
        ex:analysis.metric_fact,
        ex:analysis.period_compare,
        ex:analysis.segment_contribution,
        ex:analysis.sequential_decomposition,
        ex:analysis.turnover_driver,
        ex:dimension.period,
        ex:metric.average_daily_turnover .

ex:process.adt_analysis.execute a ex:ProcessStep ;
    rdfs:label "Compile approved mappings and execute aggregate queries" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "DeterministicExecution" ;
    ex:uses ex:join.trade_calendar,
        ex:join.trade_instrument,
        ex:rule.eligible_trade,
        ex:rule.trading_day,
        ex:source.instrument_dim,
        ex:source.trade_fact,
        ex:source.trading_calendar .

ex:process.adt_analysis.verify a ex:ProcessStep ;
    rdfs:label "Reconcile results and build claim-level evidence" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "VerifyAndEvidence" ;
    ex:uses ex:analysis.sequential_decomposition,
        ex:metric.average_daily_turnover,
        ex:metric.eligible_turnover,
        ex:metric.trading_day_count .

ex:question.adt_compare a ex:BusinessQuestion ;
    rdfs:label "ADT Comparison Question"@en,
        "ADT比较问题"@zh ;
    ex:definition "Requests the exact change between two periods." ;
    ex:id "question.adt_compare" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:usesPattern ex:analysis.period_compare ;
    ex:version "1.0.0" .

ex:question.adt_fact a ex:BusinessQuestion ;
    rdfs:label "ADT Fact Question"@en,
        "ADT事实问题"@zh ;
    ex:definition "Requests ADT for explicit periods." ;
    ex:id "question.adt_fact" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:usesPattern ex:analysis.metric_fact ;
    ex:version "1.0.0" .

ex:question.evidence a ex:BusinessQuestion ;
    rdfs:label "Evidence Question"@en,
        "证据问题"@zh ;
    ex:definition "Requests how the metric was defined, mapped, validated and calculated." ;
    ex:id "question.evidence" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:usesPattern ex:analysis.evidence_audit ;
    ex:version "1.0.0" .

ex:question.turnover_driver a ex:BusinessQuestion ;
    rdfs:label "Turnover Driver Question"@en,
        "成交额驱动问题"@zh ;
    ex:definition "Requests turnover decline, ADT context, segment contribution and deterministic decomposition." ;
    ex:id "question.turnover_driver" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:usesPattern ex:analysis.turnover_driver ;
    ex:version "1.0.0" .

ex:relationship.instrument_segment a ex:Relationship ;
    rdfs:label "Instrument belongs to Segment"@en,
        "证券属于板块"@zh ;
    ex:cardinality "N:1" ;
    ex:definition "Each instrument resolves to one governed market segment." ;
    ex:fromEntity ex:entity.instrument ;
    ex:id "relationship.instrument_segment" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.data_model ;
    ex:toEntity ex:entity.segment ;
    ex:version "1.0.0" .

ex:relationship.trade_calendar a ex:Relationship ;
    rdfs:label "Trade occurs on Trading Day"@en,
        "成交发生于交易日"@zh ;
    ex:cardinality "N:1" ;
    ex:definition "Trade date and market resolve to one governed calendar row." ;
    ex:fromEntity ex:entity.trade ;
    ex:id "relationship.trade_calendar" ;
    ex:owner ex:actor.data_steward ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.data_model ;
    ex:toEntity ex:entity.trading_day ;
    ex:version "1.0.0" .

ex:relationship.trade_instrument a ex:Relationship ;
    rdfs:label "Trade references Instrument"@en,
        "成交关联证券"@zh ;
    ex:cardinality "N:1" ;
    ex:definition "Each trade resolves to exactly one governed instrument." ;
    ex:fromEntity ex:entity.trade ;
    ex:id "relationship.trade_instrument" ;
    ex:owner ex:actor.data_steward ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.data_model ;
    ex:toEntity ex:entity.instrument ;
    ex:version "1.0.0" .

ex:scenario.adt_reference a ex:Scenario ;
    rdfs:label "ADT Reference Analysis"@en,
        "ADT参考分析"@zh ;
    ex:definition "A synthetic securities-market scenario for governed turnover and average daily turnover analysis." ;
    ex:governedByDecision ex:decision.calendar_day,
        ex:decision.eligible_trade ;
    ex:id "scenario.adt_reference" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:decision.half_day a ex:Decision ;
    ex:affects ex:metric.trading_day_count ;
    ex:decisionText "Count an approved half trading day as one trading day in this synthetic reference case." ;
    ex:id "decision.half_day" .

ex:decision.segment_contribution a ex:Decision ;
    ex:affects ex:analysis.segment_contribution ;
    ex:decisionText "Contribution is each segment turnover delta divided by total turnover delta." ;
    ex:id "decision.segment_contribution" .

ex:join.trade_calendar a ex:JoinContract ;
