ex:decision.calendar_day a ex:Decision ;
    ex:affects ex:metric.average_daily_turnover,
        ex:metric.trading_day_count ;
    ex:decisionText "Count distinct dates in the governed trading calendar where is_trading_day is true." ;
    ex:id "decision.calendar_day" .

ex:metric.eligible_turnover a ex:Metric ;
    rdfs:label "Eligible Turnover"@en,
        "合资格成交额"@zh ;
    ex:allowedDimension ex:dimension.period,
        ex:dimension.segment ;
    ex:definition "Sum of executed value for eligible trades in the governed period." ;
    ex:formulaJson "{\"args\": [{\"args\": [], \"op\": \"field_ref\", \"ref\": \"property.trade.executed_value_hkd_mn\", \"value\": null}], \"op\": \"sum\", \"ref\": null, \"value\": null}" ;
    ex:id "metric.eligible_turnover" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.existing_sql,
        ex:source.metric_logic ;
    ex:unit "HKD_MN" ;
    ex:version "1.0.0" .

ex:metric.trading_day_count a ex:Metric ;
    rdfs:label "Trading Day Count"@en,
        "交易日数"@zh ;
    ex:allowedDimension ex:dimension.period ;
    ex:definition "Count of distinct approved trading dates in the governed period." ;
    ex:formulaJson "{\"args\": [{\"args\": [], \"op\": \"field_ref\", \"ref\": \"property.calendar.calendar_date\", \"value\": null}], \"op\": \"count_distinct\", \"ref\": null, \"value\": null}" ;
    ex:governedByDecision ex:decision.calendar_day,
        ex:decision.half_day ;
    ex:id "metric.trading_day_count" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.metric_logic ;
    ex:unit "TRADING_DAY_COUNT" ;
    ex:version "1.0.0" .

ex:metric.average_daily_turnover a ex:Metric ;
    rdfs:label "Average Daily Turnover"@en,
        "平均每日成交额"@zh ;
    ex:allowedDimension ex:dimension.period,
        ex:dimension.segment ;
    ex:definition "同期间的合资格成交额除以交易日数 Reviewed through the persisted Studio API." ;
    ex:dependsOn ex:metric.eligible_turnover,
        ex:metric.trading_day_count ;
    ex:formulaJson "{\"args\": [{\"args\": [], \"op\": \"metric_ref\", \"ref\": \"metric.eligible_turnover\", \"value\": null}, {\"args\": [], \"op\": \"metric_ref\", \"ref\": \"metric.trading_day_count\", \"value\": null}], \"op\": \"divide\", \"ref\": null, \"value\": null}" ;
    ex:governedByDecision ex:decision.calendar_day,
        ex:decision.eligible_trade ;
    ex:id "metric.average_daily_turnover" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.metric_logic ;
    ex:unit "HKD_MN_PER_TRADING_DAY" ;
    ex:version "1.0.0" .

