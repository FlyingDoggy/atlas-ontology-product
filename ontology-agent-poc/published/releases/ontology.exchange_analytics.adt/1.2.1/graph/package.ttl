@prefix ex: <https://example.org/hkex/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ontology.exchange_analytics.adt a ex:OntologyPackage ;
    ex:contains ex:actor.data_steward,
        ex:actor.domain_owner,
        ex:actor.executive_viewer,
        ex:actor.external_user,
        ex:actor.market_analyst,
        ex:actor.ontology_agent,
        ex:analysis.evidence_audit,
        ex:analysis.metric_fact,
        ex:analysis.period_compare,
        ex:analysis.segment_contribution,
        ex:analysis.sequential_decomposition,
        ex:analysis.turnover_driver,
        ex:binding.calendar.date,
        ex:binding.calendar.is_trading_day,
        ex:binding.calendar.market,
        ex:binding.calendar.period,
        ex:binding.instrument.instrument_id,
        ex:binding.segment.id,
        ex:binding.segment.name,
        ex:binding.trade.cancelled,
        ex:binding.trade.executed_value,
        ex:binding.trade.instrument_id,
        ex:binding.trade.market_id,
        ex:binding.trade.order_value,
        ex:binding.trade.status,
        ex:binding.trade.trade_date,
        ex:binding.trade.trade_id,
        ex:dimension.period,
        ex:dimension.segment,
        ex:entity.instrument,
        ex:entity.segment,
        ex:entity.trade,
        ex:entity.trading_day,
        ex:join.trade_calendar,
        ex:join.trade_instrument,
        ex:metric.average_daily_turnover,
        ex:metric.eligible_turnover,
        ex:metric.trading_day_count,
        ex:policy.aggregate_market_access,
        ex:process.adt_analysis,
        ex:property.calendar.calendar_date,
        ex:property.calendar.is_trading_day,
        ex:property.calendar.market_id,
        ex:property.calendar.period_id,
        ex:property.instrument.instrument_id,
        ex:property.segment.segment_id,
        ex:property.segment.segment_name,
        ex:property.trade.cancellation_flag,
        ex:property.trade.executed_value_hkd_mn,
        ex:property.trade.instrument_id,
        ex:property.trade.market_id,
        ex:property.trade.order_value_hkd_mn,
        ex:property.trade.status,
        ex:property.trade.trade_date,
        ex:property.trade.trade_id,
        ex:question.adt_compare,
        ex:question.adt_fact,
        ex:question.evidence,
        ex:question.turnover_driver,
        ex:relationship.instrument_segment,
        ex:relationship.trade_calendar,
        ex:relationship.trade_instrument,
        ex:rule.eligible_trade,
        ex:rule.trading_day,
        ex:scenario.adt_reference,
        ex:source.instrument_dim,
        ex:source.trade_fact,
        ex:source.trading_calendar ;
    ex:status "confirmed" ;
    ex:version "1.2.1" .

ex:source.article_blocks a ex:SourceReference ;
    rdfs:label "Object, Link, Action, Function and Interface" ;
    ex:id "source.article_blocks" ;
    ex:locator "local PDF supplied by project owner" ;
    ex:trust "secondary" .

ex:source.article_semantic_web a ex:SourceReference ;
    rdfs:label "RDF, OWL, SPARQL and SHACL overview" ;
    ex:id "source.article_semantic_web" ;
    ex:locator "local PDF supplied by project owner" ;
    ex:trust "secondary" .

ex:source.human_confirmation a ex:SourceReference ;
    rdfs:label "Synthetic ADT business decisions" ;
    ex:id "source.human_confirmation" ;
    ex:locator "decision-log/ADT-001..ADT-005" ;
    ex:trust "primary" .

ex:actor.executive_viewer a ex:Actor ;
    rdfs:label "Executive Viewer"@en,
        "管理层查看者"@zh ;
    ex:definition "Permitted read-only user of approved aggregate analytics." ;
    ex:id "actor.executive_viewer" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:actor.external_user a ex:Actor ;
    rdfs:label "External User"@en,
        "外部用户"@zh ;
    ex:definition "A principal that is not permitted to access this scenario." ;
    ex:id "actor.external_user" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:actor.market_analyst a ex:Actor ;
    rdfs:label "Market Analyst"@en,
        "市场分析师"@zh ;
    ex:definition "Permitted user of aggregate market analytics." ;
    ex:id "actor.market_analyst" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

