ex:analysis.period_compare a ex:AnalysisPattern ;
    rdfs:label "Exact Period Compare"@en,
        "精确期间比较"@zh ;
    ex:definition "Compares ADT and turnover across exactly two periods." ;
    ex:id "analysis.period_compare" ;
    ex:owner ex:actor.domain_owner ;
    ex:requiresDimension ex:dimension.period ;
    ex:requiresMetric ex:metric.average_daily_turnover ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:analysis.segment_contribution a ex:AnalysisPattern ;
    rdfs:label "Segment Contribution"@en,
        "板块贡献"@zh ;
    ex:definition "Reconciles segment turnover deltas and ranks contribution to total turnover change." ;
    ex:governedByDecision ex:decision.segment_contribution ;
    ex:id "analysis.segment_contribution" ;
    ex:owner ex:actor.domain_owner ;
    ex:requiresDimension ex:dimension.period,
        ex:dimension.segment ;
    ex:requiresMetric ex:metric.eligible_turnover ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.metric_logic,
        ex:source.requirements ;
    ex:version "1.0.0" .

ex:analysis.turnover_driver a ex:AnalysisPattern ;
    rdfs:label "Governed Turnover Driver Analysis"@en,
        "受治理成交额驱动分析"@zh ;
    ex:definition "Combines period facts, turnover change, segment contribution and a disclosed calendar-first non-causal decomposition." ;
    ex:governedByDecision ex:decision.decomposition,
        ex:decision.segment_contribution ;
    ex:id "analysis.turnover_driver" ;
    ex:owner ex:actor.domain_owner ;
    ex:requiresDimension ex:dimension.period,
        ex:dimension.segment ;
    ex:requiresMetric ex:metric.average_daily_turnover,
        ex:metric.eligible_turnover,
        ex:metric.trading_day_count ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.metric_logic,
        ex:source.requirements ;
    ex:version "1.0.0" .

ex:decision.decomposition a ex:Decision ;
    ex:affects ex:analysis.sequential_decomposition ;
    ex:decisionText "Use sequential calendar-first decomposition and disclose that it is order-dependent and non-causal." ;
    ex:id "decision.decomposition" .

ex:rule.eligible_trade a ex:Rule ;
    rdfs:label "Eligible Trade"@en,
        "合资格成交"@zh ;
    ex:definition "Include EXECUTED trades and exclude cancelled records." ;
    ex:governedByDecision ex:decision.eligible_trade ;
    ex:id "rule.eligible_trade" ;
    ex:owner ex:actor.domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.existing_sql,
        ex:source.metric_logic ;
    ex:version "1.0.0" .

ex:analysis.sequential_decomposition a ex:AnalysisPattern ;
    rdfs:label "Calendar-first Decomposition"@en,
        "日历优先分解"@zh ;
    ex:definition "Decomposes turnover change into trading-day and activity effects using a disclosed sequential convention." ;
    ex:governedByDecision ex:decision.decomposition ;
    ex:id "analysis.sequential_decomposition" ;
    ex:owner ex:actor.domain_owner ;
    ex:requiresDimension ex:dimension.period ;
    ex:requiresMetric ex:metric.average_daily_turnover,
        ex:metric.eligible_turnover,
        ex:metric.trading_day_count ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:decision.eligible_trade a ex:Decision ;
    ex:affects ex:metric.eligible_turnover,
        ex:rule.eligible_trade ;
    ex:decisionText "Include status EXECUTED and exclude cancellation_flag true." ;
    ex:id "decision.eligible_trade" .

