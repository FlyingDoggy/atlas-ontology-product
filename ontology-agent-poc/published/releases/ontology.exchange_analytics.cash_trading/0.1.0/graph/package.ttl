ex:join.trade_sell_participant a ex:JoinContract ;
    rdfs:label "Trade to Sell Participant"@en,
        "成交关联卖方参与者"@zh ;
    ex:definition "Resolve the selling participant where available." ;
    ex:id "join.trade_sell_participant" ;
