ex:decision.calendar_key a ex:Decision ;
    ex:affects ex:property.calendar.calendar_key ;
    ex:decisionText "Use calendar_code + business_date." ;
    ex:id "decision.calendar_key" .

ex:decision.cancel_spelling a ex:Decision ;
    ex:affects ex:property.order.order_status ;
    ex:decisionText "Use CANCELED and accept CANCELLED only as an input alias." ;
    ex:id "decision.cancel_spelling" .

ex:decision.order_lifecycle a ex:Decision ;
    ex:affects ex:entity.order_activity,
        ex:property.order.order_id ;
    ex:decisionText "Use venue_code + trading_date + order_id and disclose incomplete observed timelines." ;
    ex:id "decision.order_lifecycle" .

ex:join.trade_buy_participant a ex:JoinContract ;
    rdfs:label "Trade to Buy Participant"@en,
        "成交关联买方参与者"@zh ;
    ex:definition "Resolve the buying participant where available." ;
    ex:id "join.trade_buy_participant" ;
    ex:owner ex:actor.cash_trading_data_steward ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.data_dictionary ;
    ex:version "1.0.0" .

ex:join.trade_calendar a ex:JoinContract ;
    rdfs:label "Trade to Calendar"@en,
        "成交关联日历"@zh ;
    ex:definition "Resolve a trade to its venue calendar date." ;
    ex:id "join.trade_calendar" ;
    ex:owner ex:actor.cash_trading_data_steward ;
