ex:process.cash_trading_analysis.authorize a ex:ProcessStep ;
    rdfs:label "Resolve role, time window and output grain" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "PolicyGate" ;
    ex:uses ex:policy.cash_markets_demo,
        ex:policy.cash_surveillance_demo .

ex:process.cash_trading_analysis.bind a ex:ProcessStep ;
    rdfs:label "Bind the question to a registered analysis pattern and metrics" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "SemanticBinding" ;
    ex:uses ex:analysis.cash_evidence_audit,
        ex:analysis.self_trade_summary,
        ex:analysis.self_trade_timeline,
        ex:analysis.self_trade_trend,
        ex:analysis.trade_latency_profile .

ex:process.cash_trading_analysis.evidence a ex:ProcessStep ;
    rdfs:label "Attach claims to metrics, decisions, data and query identities" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "EvidenceAssembly" ;
    ex:uses ex:analysis.cash_evidence_audit .

ex:process.cash_trading_analysis.execute a ex:ProcessStep ;
    rdfs:label "Execute bounded DuckDB tools over verified Parquet" ;
    ex:actor ex:actor.ontology_agent ;
    ex:operation "DeterministicExecution" ;
    ex:uses ex:rule.eligible_trade,
        ex:rule.nonnegative_latency,
        ex:rule.potential_self_trade,
        ex:rule.self_trade_eligible,
        ex:source.cash_trade_analytics .

ex:property.calendar.business_date a ex:Property ;
    rdfs:label "Calendar Business Date"@en,
        "日历业务日期"@zh ;
    ex:dataType "date" ;
    ex:definition "Business date represented by the calendar row." ;
    ex:id "property.calendar.business_date" ;
    ex:owner ex:actor.cash_trading_data_steward ;
    ex:propertyOf ex:entity.trading_day ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.data_dictionary ;
    ex:version "1.0.0" .

ex:property.calendar.is_trading_day a ex:Property ;
    rdfs:label "Is Trading Day"@en,
        "是否交易日"@zh ;
    ex:dataType "enum" ;
    ex:definition "Trading-day indicator." ;
    ex:id "property.calendar.is_trading_day" ;
    ex:owner ex:actor.cash_trading_data_steward ;
    ex:propertyOf ex:entity.trading_day ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.data_dictionary ;
    ex:version "1.0.0" .

ex:property.instrument.instrument_id a ex:Property ;
    rdfs:label "Instrument ID"@en,
        "证券ID"@zh ;
    ex:dataType "string" ;
