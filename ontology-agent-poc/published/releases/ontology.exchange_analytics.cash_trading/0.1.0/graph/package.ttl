ex:analysis.self_trade_summary a ex:AnalysisPattern ;
    rdfs:label "Potential Self-Trade Summary"@en,
        "潜在自成交汇总"@zh ;
    ex:definition "Return eligible count, candidate count, rate and top candidate dimensions." ;
    ex:id "analysis.self_trade_summary" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:requiresMetric ex:metric.potential_self_trade_count,
        ex:metric.potential_self_trade_rate,
        ex:metric.self_trade_eligible_trade_count ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.assumption_register,
        ex:source.requirements ;
    ex:version "1.0.0" .

ex:analysis.self_trade_timeline a ex:AnalysisPattern ;
    rdfs:label "Potential Self-Trade Evidence Timeline"@en,
        "潜在自成交证据时间线"@zh ;
    ex:definition "Return the selected participant's candidate trades and linked observed order events in chronological order." ;
    ex:id "analysis.self_trade_timeline" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:requiresDimension ex:dimension.participant ;
    ex:requiresMetric ex:metric.potential_self_trade_count ;
