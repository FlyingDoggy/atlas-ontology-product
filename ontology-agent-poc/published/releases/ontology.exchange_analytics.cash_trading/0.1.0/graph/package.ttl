ex:source.derived_oracle a ex:SourceReference ;
    rdfs:label "Independent constructed-synthetic golden controls" ;
    ex:id "source.derived_oracle" ;
    ex:locator "golden/oracle.json sha256=dc842cc1f27dbf3fa80c3f18aa1a6c1e26e64614df6d8c1ceb6793edcc815fe0" ;
    ex:trust "assumption" .

ex:actor.external_user a ex:Actor ;
    rdfs:label "External User"@en,
        "外部用户"@zh ;
    ex:definition "A principal denied access to scenario data and evidence." ;
    ex:id "actor.external_user" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:actor.market_surveillance_user a ex:Actor ;
    rdfs:label "Market Surveillance User"@en,
        "市场监察用户"@zh ;
    ex:definition "Reviews potential self-trade candidates and their synthetic evidence." ;
    ex:id "actor.market_surveillance_user" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:actor.markets_user a ex:Actor ;
    rdfs:label "Markets User"@en,
        "市场业务用户"@zh ;
    ex:definition "Consumes aggregate market trends with participant identifiers redacted." ;
    ex:id "actor.markets_user" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

ex:actor.trading_user a ex:Actor ;
