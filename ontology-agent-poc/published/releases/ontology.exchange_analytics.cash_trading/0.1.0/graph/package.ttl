        "交易用户"@zh ;
    ex:definition "Reviews synthetic trading operations and latency analytics." ;
    ex:id "actor.trading_user" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.requirements ;
    ex:version "1.0.0" .

