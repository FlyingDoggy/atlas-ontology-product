ex:decision.notional_currency a ex:Decision ;
    ex:affects ex:property.trade.base_notional_usd,
        ex:property.trade.trade_notional_hkd ;
    ex:decisionText "Label trade_notional as HKD and base_notional_before_haircut as USD." ;
    ex:id "decision.notional_currency" .

ex:decision.self_trade_denominator a ex:Decision ;
    ex:affects ex:metric.potential_self_trade_rate,
        ex:metric.self_trade_eligible_trade_count,
        ex:rule.self_trade_eligible ;
    ex:decisionText "Use eligible active trades with both-side participant IDs." ;
    ex:id "decision.self_trade_denominator" .

