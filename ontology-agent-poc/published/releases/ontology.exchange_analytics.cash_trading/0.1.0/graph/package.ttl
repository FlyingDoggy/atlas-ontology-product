ex:metric.eligible_trade_count a ex:Metric ;
    rdfs:label "Eligible Trade Count"@en,
        "合格成交笔数"@zh ;
    ex:allowedDimension ex:dimension.business_date,
        ex:dimension.instrument,
        ex:dimension.market_segment,
        ex:dimension.participant ;
    ex:definition "Distinct eligible active trades in the selected cohort." ;
    ex:formulaJson "{\"args\": [{\"args\": [], \"op\": \"field_ref\", \"ref\": \"property.trade.trading_activity_id\", \"value\": null}], \"op\": \"count_distinct\", \"ref\": null, \"value\": null}" ;
    ex:governedByDecision ex:decision.trade_eligibility ;
    ex:id "metric.eligible_trade_count" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.assumption_register,
        ex:source.metric_logic ;
    ex:unit "TRADE" ;
    ex:version "1.0.0" .

ex:process.cash_trading_analysis a ex:Process ;
    rdfs:label "Governed Cash Trading Analysis"@en,
        "受治理现金交易分析"@zh ;
    ex:definition "From a natural-language question to a policy-scoped deterministic result and evidence-backed explanation." ;
    ex:governedByDecision ex:decision.demo_policy,
        ex:decision.source_classification ;
    ex:hasStep ex:process.cash_trading_analysis.authorize,
        ex:process.cash_trading_analysis.bind,
        ex:process.cash_trading_analysis.evidence,
        ex:process.cash_trading_analysis.execute ;
    ex:id "process.cash_trading_analysis" ;
    ex:owner ex:actor.cash_trading_domain_owner ;
    ex:status "confirmed" ;
    ex:supportedBy ex:source.assumption_register,
        ex:source.requirements ;
    ex:trigger "An authorized demo user asks a supported self-trade, latency or evidence question." ;
    ex:version "1.0.0" .

